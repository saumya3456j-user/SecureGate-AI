# SecureGate AI Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Local or MongoDB Atlas URI)
# For local MongoDB: mongodb://127.0.0.1:27017/securegate_db
# For Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/securegate_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/securegate_db

# JWT Dashboard Authentication Secret
JWT_SECRET=securegate_super_secret_jwt_key_replace_in_production_2026_xyz!
JWT_EXPIRES_IN=8h

# Device Authentication Key (Shared secret between ESP32 and Backend)
DEVICE_ID=ESP32_SECUREGATE_01
DEVICE_API_KEY=SG-DEV-KEY-98472910-ESP32-AUTH-TOKEN

# SMTP Email Configuration (Nodemailer)
# Use your Gmail address and 16-character App Password (not your normal Gmail password)
# Or configure any other SMTP provider (SendGrid, Mailgun, Amazon SES, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM_NAME=SecureGate AI
SMTP_FROM_EMAIL=no-reply@securegate.local

# Security Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OFFLINE_CODE_EXPIRY_MINUTES=5
COMMAND_EXPIRY_SECONDS=30

# Fallback Mode for Testing Without Real SMTP (logs OTP to console & return preview url if Ethereal)
EMAIL_SIMULATION_MODE=true

